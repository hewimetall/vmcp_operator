{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "vmcp-operator values",
  "type": "object",
  "required": ["watchNamespaces", "policy", "image", "replicaCount"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "MVP hard-lock; HA/peering not implemented."
    },
    "watchNamespaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Explicit namespace allowlist; cluster-wide watch forbidden."
    },
    "policy": {
      "type": "object",
      "required": ["allowedImagePrefixes"],
      "properties": {
        "allowedImagePrefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string" }
      }
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authSecretRef": { "type": "object" },
        "route": { "type": "object" }
      }
    }
  }
}
